{
  "name": "granite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p tsconfig.storybook.json",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "chromatic": "CHROMATIC_ARCHIVE_LOCATION=chromatic-results chromatic --playwright",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build --disable-telemetry --output-dir dist/storybook",
    "test:components": "playwright test --config playwright.components.config.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@hongdown/wasm": "0.5.3",
    "@lezer/highlight": "^1.2.0",
    "@solidjs/web": "2.0.0-rc.18",
    "katex": "^0.19.0",
    "mermaid": "^12.2.0",
    "solid-js": "2.0.0-rc.18",
    "yaml": "^2"
  },
  "devDependencies": {
    "@chromatic-com/playwright": "^1.0.0",
    "@playwright/test": "^1.58.0",
    "@solidjs/vite-plugin": "3.0.0-next.51",
    "@testing-library/dom": "^10.4.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "chromatic": "^18.13.3",
    "csstype": "3.2.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "storybook": "10.6.3",
    "storybook-solidjs-vite": "10.7.4",
    "typescript": "~5.8.3",
    "vite": "^8.3.5",
    "vite-plugin-solid": "npm:@solidjs/vite-plugin@3.0.0-next.51",
    "vitest": "^5.0.5"
  },
  "packageManager": "yarn@4.18.1",
  "license": "AGPL-3.0-or-later"
}
